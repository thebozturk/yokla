                                  "verdict",
                                  "severity",
                                  "message"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "unmeasured": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "dimension": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                                  },
                                  "reason": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "dimension",
                                  "reason"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "check",
                            "applicable",
                            "findings"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "user",
                      "checks"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "index",
                "cache",
                "turns"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "suite",
          "language",
          "status",
          "unstable",
          "dimensions",
          "samples"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "applied": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "notApplicable": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "passed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "failed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errors": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unmeasured": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
