{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "yokla.results/v1"
    },
    "yokla": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "profile": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "target",
            "sha256"
          ],
          "additionalProperties": false
        },
        "environment": {
          "type": "object",
          "properties": {
            "node": {
              "type": "string"
            },
            "platform": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            }
          },
          "required": [
            "node",
            "platform",
            "arch"
          ],
          "additionalProperties": false
        },
        "correlation": {
          "type": "string",
          "enum": [
            "none",
            "serial",
            "header",
            "traceparent"
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "observation": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "const": "target-logs"
            },
            "correlation": {
              "type": "string",
              "enum": [
                "request-id",
                "target-id",
                "order"
              ]
            },
            "lines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "matched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unmatched": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totals": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "missing": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "required": [
            "source",
            "correlation",
            "lines",
            "matched",
            "unmatched",
            "totals",
            "missing"
          ],
          "additionalProperties": false
        },
        "proxy": {
          "type": "object",
          "properties": {
            "correlation": {
              "type": "string",
              "enum": [
                "serial",
                "header"
              ]
            },
            "records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "attributed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unattributed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "totals": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            },
            "missing": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "prompts": {
              "type": "string",
              "enum": [
                "sizes",
                "hashed",
                "redacted",
                "full"
              ]
            }
          },
          "required": [
            "correlation",
            "records",
            "attributed",
            "unattributed",
            "totals",
            "missing"
          ],
          "additionalProperties": false
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "startedAt",
        "finishedAt",
        "durationMs",
        "profile",
        "environment",
        "correlation",
        "partial"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "suite": {
            "type": "string",
            "enum": [
              "quality",
              "factual",
              "redteam",
              "robustness",
              "perf",
              "resilience"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "definitionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error",
              "fixture-missing",
              "known-gap",
              "gap-closed",
              "unmeasured"
            ]
          },
          "unstable": {
            "type": "boolean"
          },
          "knownGap": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              },
              "issue": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "review": {
            "type": "string",
            "const": "proposed"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "dimension": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                },
                "policy": {
                  "type": "string",
                  "enum": [
                    "worst-of-n",
                    "majority-of-n",
                    "percentile",
                    "mean",
                    "advisory"
                  ]
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "unmeasured"
                  ]
                },
                "samples": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "interval": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "number",
                      "const": 0.95
                    },
                    "lower": {
                      "type": "number"
                    },
                    "upper": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "level",
                    "lower",
                    "upper"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "dimension",
                "policy",
                "verdict",
                "samples",
                "failed"
              ],
              "additionalProperties": false
            }
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "cache": {
                  "type": "string",
                  "enum": [
                    "cold",
                    "warm"
                  ]
                },
                "turns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "user": {
                        "type": "string"
                      },
                      "requestId": {
                        "type": "string"
                      },
                      "response": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "latencyMs": {
                            "type": "number",
                            "minimum": 0
                          },
                          "firstTextMs": {
                            "type": "number",
                            "minimum": 0
                          },
                          "id": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "route": {
                            "type": "string"
                          },
                          "evidence": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/__schema0"
                              }
                            }
                          }
                        },
                        "required": [
                          "status",
                          "latencyMs",
                          "evidence"
                        ],
                        "additionalProperties": false
                      },
                      "clarifying": {
                        "type": "boolean"
                      },
                      "observed": {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string",
                            "const": "target-logs"
                          },
                          "correlation": {
                            "type": "string",
                            "enum": [
                              "request-id",
                              "target-id",
                              "order"
                            ]
                          },
                          "fields": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {
                              "$ref": "#/$defs/__schema1"
                            }
                          }
                        },
                        "required": [
                          "source",
                          "correlation",
                          "fields"
                        ],
                        "additionalProperties": false
                      },
                      "proxy": {
                        "type": "object",
                        "properties": {
                          "correlation": {
                            "type": "string",
                            "enum": [
                              "serial",
                              "header"
                            ]
                          },
                          "trace": {
                            "type": "string"
                          },
                          "calls": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "upstream": {
                                  "type": "string",
                                  "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                                },
                                "model": {
                                  "type": [
                                    "string",
                                    "null"
                                  ]
                                },
                                "status": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": -9007199254740991,
                                      "maximum": 9007199254740991
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "durationMs": {
                                  "type": "number",
                                  "minimum": 0
                                },
                                "stream": {
                                  "type": "boolean"
                                },
                                "usage": {
                                  "type": "object",
                                  "properties": {
                                    "input": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "output": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "cachedInput": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "cacheWrite": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "reasoning": {
                                      "anyOf": [
                                        {
                                          "type": "integer",
                                          "minimum": 0,
                                          "maximum": 9007199254740991
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "required": [
                                    "input",
                                    "output",
                                    "cachedInput",
                                    "cacheWrite",
                                    "reasoning"
                                  ],
                                  "additionalProperties": false
                                },
                                "costUsd": {
                                  "anyOf": [
                                    {
                                      "type": "number",
                                      "minimum": 0
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "fault": {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string"
                                    },
                                    "applied": {
                                      "type": "boolean"
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "applied"
                                  ],
                                  "additionalProperties": false
                                },
                                "prompt": {
                                  "anyOf": [
                                    {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "role": {
                                            "type": "string",
                                            "enum": [
                                              "system",
                                              "user",
                                              "assistant",
                                              "tool",
                                              "input"
                                            ]
                                          },
                                          "chars": {
                                            "type": "integer",
                                            "minimum": 0,
                                            "maximum": 9007199254740991
                                          },
                                          "sha256": {
                                            "type": "string",
                                            "pattern": "^[0-9a-f]{64}$"
                                          },
                                          "text": {
                                            "type": "string"
                                          }
                                        },
                                        "required": [
                                          "role",
                                          "chars"
                                        ],
                                        "additionalProperties": false
                                      }
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                }
                              },
                              "required": [
                                "id",
                                "upstream",
                                "model",
                                "status",
                                "durationMs",
                                "stream",
                                "usage",
                                "costUsd"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "costUsd": {
                            "anyOf": [
                              {
                                "type": "number",
                                "minimum": 0
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "correlation",
                          "calls",
                          "costUsd"
                        ],
                        "additionalProperties": false
