        "required": [
          "check",
          "applied",
          "notApplicable",
          "passed",
          "failed",
          "errors"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "statuses": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error",
              "fixture-missing",
              "known-gap",
              "gap-closed",
              "unmeasured"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "cases",
        "statuses"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "yokla",
    "run",
    "cases",
    "checks",
