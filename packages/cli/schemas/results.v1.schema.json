                                    "type": "string",
                                    "enum": [
                                      "pass",
                                      "fail",
                                      "error"
                                    ]
                                  },
                                  "severity": {
                                    "type": "string",
                                    "enum": [
                                      "info",
                                      "low",
                                      "medium",
                                      "high",
                                      "critical"
                                    ]
                                  },
                                  "message": {
                                    "type": "string"
                                  },
