{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "yokla.baseline/v1"
    },
    "yokla": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "profile": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "target",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "startedAt",
        "profile"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "suite": {
            "type": "string",
            "enum": [
              "quality",
              "factual",
              "redteam",
              "robustness",
              "perf",
              "resilience"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "error",
              "fixture-missing",
              "known-gap",
              "gap-closed",
              "unmeasured"
            ]
          },
          "definitionSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "suite",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "yokla",
    "run",
    "cases"
  ],
  "additionalProperties": false
}
