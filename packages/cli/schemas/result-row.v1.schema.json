{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "yokla.result-row/v1"
    },
    "run": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "string",
      "minLength": 1
    },
    "suite": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sample": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "turn": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "message": {
      "type": "string"
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "latencyMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "costUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unmeasured"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "fixture-missing",
        "known-gap",
        "gap-closed",
        "unmeasured"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "check",
          "dimension",
          "verdict",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "run",
    "case",
    "suite",
    "language",
    "tags",
    "sample",
    "turn",
    "message",
    "answer",
    "latencyMs",
    "costUsd",
    "verdict",
    "status",
    "findings"
  ],
  "additionalProperties": false,
  "title": "yokla result row v1"
}
