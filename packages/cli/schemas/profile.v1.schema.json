{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "target": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "const": "http"
        },
        "request": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1,
              "description": "May contain {{env.NAME}}."
            },
            "method": {
              "default": "POST",
              "type": "string",
              "enum": [
                "POST",
                "PUT",
                "PATCH"
              ]
            },
            "headers": {
              "description": "Values may contain {{env.NAME}}. Secrets belong in the environment.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "description": "JSON body. Strings may contain {{message}}, {{session}}, {{requestId}}, {{carry.NAME}} and {{env.NAME}}. A string that is only a placeholder with no value is left out.",
              "$ref": "#/$defs/__schema0"
            },
            "timeoutMs": {
              "default": 30000,
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            },
            "requestId": {
              "description": "Send a unique id per request in this header, for log correlation.",
              "type": "object",
              "properties": {
                "header": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "header"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "response": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$",
              "description": "Where the assistant's answer text is."
            },
            "route": {
              "type": "string",
              "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
            },
            "id": {
              "description": "Where the target's own request id is.",
              "type": "string",
              "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
            },
            "clarification": {
              "description": "Routes that mean the target asked a clarifying question; product expectations then do not apply to that turn.",
              "type": "object",
              "properties": {
                "routes": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "routes"
              ],
              "additionalProperties": false
            },
            "evidence": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "string",
                    "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$",
                    "description": "Where the items are in the response, e.g. $.data.products[*]."
                  },
                  "fields": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][A-Za-z0-9]*$"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "from": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                                },
                                {
                                  "minItems": 1,
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                                  }
                                }
                              ]
                            },
                            "as": {
                              "description": "Convert the value, e.g. a decimal string to a number.",
                              "type": "string",
                              "enum": [
                                "string",
                                "number",
                                "boolean"
                              ]
                            }
                          },
                          "required": [
                            "from"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "description": "Evidence field → where it is in each item, e.g. price: price.amount, or price: { from: [price.salePrice, price.listPrice], as: number }."
                  }
                },
                "required": [
                  "items",
                  "fields"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        },
        "session": {
          "default": {
            "mode": "client",
            "carry": []
          },
          "type": "object",
          "properties": {
            "mode": {
              "default": "client",
              "description": "client: yokla sends a new {{session}} id per sample.",
              "type": "string",
              "enum": [
                "client",
                "none"
              ]
            },
            "carry": {
              "default": [],
              "description": "Values read from each response and sent with the next turn as {{carry.NAME}}, e.g. a server-issued conversation id.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]*$"
                  },
                  "from": {
                    "type": "string",
                    "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
                  }
                },
                "required": [
                  "name",
                  "from"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "burstPerSecond": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "perMinute": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "perHour": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "retryAfter": {
              "default": {
                "headers": [
                  "retry-after"
                ],
                "unit": "seconds",
                "maxWaitMs": 60000
              },
              "type": "object",
              "properties": {
                "headers": {
                  "default": [
                    "retry-after"
                  ],
                  "description": "Header names to read; a trailing * matches a prefix, e.g. retry-after-*.",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "unit": {
                  "default": "seconds",
                  "type": "string",
                  "enum": [
                    "seconds",
                    "milliseconds"
                  ]
                },
                "maxWaitMs": {
                  "default": 60000,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                }
              },
              "additionalProperties": false
            },
            "clientIdentity": {
              "description": "Opt-in: send a rotating client address when the target limits per address.",
              "type": "object",
              "properties": {
                "header": {
                  "type": "string",
                  "minLength": 1,
                  "description": "e.g. x-forwarded-for"
                },
                "pool": {
                  "type": "string",
                  "const": "test-net",
                  "description": "Addresses from the TEST-NET ranges (RFC 5737)."
                },
                "per": {
                  "default": "case",
                  "type": "string",
                  "enum": [
                    "case",
                    "sample"
                  ]
                }
              },
              "required": [
                "header",
                "pool"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "cacheBypass": {
          "default": {
            "kind": "none"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "header"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "default": "1",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "command"
                },
                "run": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Program and arguments, e.g. [docker, compose, logs, backend]. No shell."
                },
                "timeoutMs": {
                  "default": 30000,
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 600000
                }
              },
              "required": [
                "kind",
                "run"
              ],
              "additionalProperties": false,
              "description": "Runs before each cold sample, e.g. to clear the target cache."
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "none"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        },
        "observe": {
          "type": "object",
          "properties": {
            "logs": {
              "type": "object",
              "properties": {
                "source": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "file"
                        },
                        "path": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "command"
                        },
                        "run": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "Program and arguments, e.g. [docker, compose, logs, backend]. No shell."
                        },
                        "timeoutMs": {
                          "default": 30000,
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 600000
                        }
                      },
                      "required": [
                        "kind",
                        "run"
                      ],
                      "additionalProperties": false,
                      "description": "Arguments may contain {{startedAt}}, the run start as an ISO 8601 time."
                    }
                  ]
                },
                "contains": {
                  "description": "Only lines whose text (colour codes removed) contains this, e.g. a log context outside the JSON.",
                  "type": "string",
                  "minLength": 1
                },
                "match": {
                  "default": [],
                  "description": "Only lines where every path has this value, e.g. a log context.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
                      },
                      "equals": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "equals"
                    ],
                    "additionalProperties": false
                  }
                },
                "correlate": {
                  "type": "object",
                  "properties": {
                    "by": {
                      "type": "string",
                      "enum": [
                        "request-id",
                        "target-id",
                        "order"
                      ]
                    },
                    "field": {
                      "description": "The line field holding the id.",
                      "type": "string",
                      "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
                    }
                  },
                  "required": [
                    "by"
                  ],
                  "additionalProperties": false
                },
                "fields": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]*$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string",
                            "pattern": "^\\$(?:\\.[A-Za-z_][\\w-]*|\\['[^'\\\\]*'\\]|\\[\\d+\\]|\\[\\*\\])*$"
                          },
                          "reduce": {
                            "default": "first",
                            "type": "string",
                            "enum": [
                              "first",
                              "sum",
                              "count",
                              "any",
                              "all"
                            ]
                          }
                        },
                        "required": [
                          "from"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "source",
                "correlate",
                "fields"
              ],
              "additionalProperties": false,
              "description": "ADR-0009. Lines are JSON; text before the first \"{\" is ignored."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "adapter",
        "request",
        "response"
      ],
      "additionalProperties": false
    },
    "languages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "tr",
          "en"
        ]
      }
    },
    "domain": {
      "type": "string",
      "enum": [
        "ecommerce"
      ]
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "human"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "default": "approved",
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "doc",
                      "prompt",
                      "contract",
                      "data",
                      "code",
                      "probe",
                      "import"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "source",
                  "evidence",
                  "status"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "refusal": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ]
          },
          "additionalProperties": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ecommerce": {
      "type": "object",
      "properties": {
        "neverFabricate": {
          "default": [
            "price",
            "stock",
            "discount",
            "shipping",
            "returns",
            "warranty"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "price",
              "stock",
              "discount",
              "shipping",
              "returns",
              "warranty"
            ]
          }
        },
        "policies": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "none"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false,
                "description": "No source: any concrete claim about this policy is a finding."
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "faq"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "description": "JSON Lines file, relative to the profile."
                  },
                  "topic": {
                    "description": "The FAQ topic to read; defaults to the policy key.",
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                  }
                },
                "required": [
                  "source",
                  "path"
                ],
                "additionalProperties": false,
                "description": "FAQ rows carry topic, lang and answer."
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "text"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source",
                  "text"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "catalog": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "file"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "JSON Lines file, relative to the profile."
            },
            "fields": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                },
                "type": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                },
                "price": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                },
                "stock": {
                  "description": "null in the data means unknown, not zero.",
                  "type": "string",
                  "pattern": "^[A-Za-z_][\\w-]*(?:\\.[A-Za-z_][\\w-]*)*$"
                }
              },
              "required": [
                "id",
                "type",
                "price"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "path",
            "fields"
          ],
          "additionalProperties": false
        },
        "campaigns": {
          "default": [],
          "description": "Amounts an answer may show besides product prices (design §10).",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "human"
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "default": "approved",
                        "type": "string",
                        "enum": [
                          "proposed",
                          "approved",
                          "rejected"
                        ]
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "doc",
                          "prompt",
                          "contract",
                          "data",
                          "code",
                          "probe",
                          "import"
                        ]
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "proposed",
                          "approved",
                          "rejected"
                        ]
                      }
                    },
                    "required": [
                      "source",
                      "evidence",
                      "status"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "amount",
              "currency"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "target",
    "languages",
    "domain"
  ],
  "additionalProperties": false,
  "title": "yokla profile v1",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
