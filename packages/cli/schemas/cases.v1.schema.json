{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "suite": {
            "type": "string",
            "enum": [
              "quality",
              "factual",
              "redteam",
              "robustness",
              "perf",
              "resilience"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ]
          },
          "turns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string",
                  "minLength": 1
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "description": "Merged into the profile body: objects merge, other values replace.",
                      "$ref": "#/$defs/__schema0"
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "description": "Extra request content for this turn only."
                },
                "faults": {
                  "description": "Provider faults the model proxy injects into this turn (ADR-0013); the first plan that matches a call applies.",
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "fault": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "status"
                              },
                              "status": {
                                "anyOf": [
                                  {
                                    "type": "number",
                                    "const": 429
                                  },
                                  {
                                    "type": "number",
                                    "const": 500
                                  },
                                  {
                                    "type": "number",
                                    "const": 503
                                  }
                                ]
                              },
                              "retryAfterS": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 3600
                              }
                            },
                            "required": [
                              "kind",
                              "status"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "latency"
                              },
                              "ms": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 600000
                              },
                              "jitterMs": {
                                "default": 0,
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 600000
                              }
                            },
                            "required": [
                              "kind",
                              "ms"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "timeout"
                              },
                              "holdMs": {
                                "default": 120000,
                                "description": "How long the connection stays open without an answer.",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 600000
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "malformed-json"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "empty-content"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "truncated-stream"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "kind": {
                                "type": "string",
                                "const": "invalid-tool-call"
                              }
                            },
                            "required": [
                              "kind"
                            ],
                            "additionalProperties": false
                          }
                        ]
                      },
                      "calls": {
                        "description": "The turn's model calls it applies to, from 1. Default: every call.",
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "upstream": {
                        "description": "Only calls to this upstream. Default: every one.",
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                      }
                    },
                    "required": [
                      "fault"
                    ],
                    "additionalProperties": false
                  }
                },
                "expect": {
                  "description": "Expectations for the response to this turn.",
                  "type": "object",
                  "properties": {
                    "route": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      ],
                      "description": "The route(s) that may answer this turn."
                    },
                    "answer": {
                      "type": "object",
                      "properties": {
                        "contains": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "notContains": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "notEmpty": {
                          "description": "The answer text has at least one letter or digit (ADR-0018).",
                          "type": "boolean",
                          "const": true
                        }
                      },
                      "additionalProperties": false,
                      "description": "Text the answer must or must not contain, after the language pack's folding, and whether it may be empty."
                    },
                    "language": {
                      "type": "string",
                      "pattern": "^[a-z]{2}$",
                      "description": "The language the answer must be in, judged by language-match (ADR-0018)."
                    },
                    "allowStatus": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 300,
                        "maximum": 599
                      },
                      "description": "Non-2xx statuses that count as a handled answer, such as 400 for an empty message. The turn is then judged on its status, never stopped by it (ADR-0018)."
                    },
                    "deadlineMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991,
                      "description": "The answer must arrive within this many milliseconds."
                    },
                    "budget": {
                      "type": "object",
                      "properties": {
                        "costUsd": {
                          "type": "number",
                          "minimum": 0
                        },
                        "modelCalls": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "inputTokens": {
                          "description": "The most input tokens any one model call of the turn may send (ADR-0015).",
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "additionalProperties": false,
                      "description": "The most the turn's model calls may cost, how many there may be (ADR-0014), and how large each prompt may be (ADR-0015)."
                    },
                    "notSentToModel": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": "Seeded values, such as fake personal data, that must not appear in any message of the turn's model calls (ADR-0015)."
                    },
                    "evidence": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "min": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "max": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "includes": {
                            "description": "Item ids that must be returned.",
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false
                      },
                      "description": "Expectations per evidence collection, e.g. products: { min: 1 }."
                    },
                    "filters": {
                      "type": "object",
                      "properties": {
                        "maxPrice": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minPrice": {
                          "type": "number",
                          "minimum": 0
                        },
                        "attributes": {
                          "description": "Evidence field name → required value.",
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false,
                      "description": "The filters the user asked for."
                    },
                    "productType": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      ],
                      "description": "The product type(s) the user asked for, as catalog types. A product of a type under one of them (by typeSeparator) matches."
                    },
                    "absentType": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The requested product type is absent from the catalog."
                    },
                    "answerable": {
                      "type": "boolean",
                      "description": "The request is answerable; a refusal is over-refusal."
                    },
                    "policyTopic": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
                      "description": "The turn asks about this policy."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "user"
              ],
              "additionalProperties": false
            }
          },
          "samples": {
            "description": "How many times to run the case. Default: yokla run --samples, else 1.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "checks": {
            "description": "Run only these checks. By default every applicable check runs.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "knownGap": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "human"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "default": "approved",
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "doc",
                      "prompt",
                      "contract",
                      "data",
                      "code",
                      "probe",
                      "import",
                      "template"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "source",
                  "evidence",
                  "status"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "suite",
          "language",
          "turns"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "title": "yokla cases v1",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
