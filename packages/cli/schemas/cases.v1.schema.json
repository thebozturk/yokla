{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "cases": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "suite": {
            "type": "string",
            "enum": [
              "quality",
              "factual",
              "redteam",
              "robustness",
              "perf",
              "resilience"
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "tr",
              "en"
            ]
          },
          "turns": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user": {
                  "type": "string",
                  "minLength": 1
                },
                "request": {
                  "type": "object",
                  "properties": {
                    "body": {
                      "description": "Merged into the profile body: objects merge, other values replace.",
                      "$ref": "#/$defs/__schema0"
                    },
                    "headers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "minLength": 1
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false,
                  "description": "Extra request content for this turn only."
                },
                "expect": {
                  "description": "Expectations for the response to this turn.",
                  "type": "object",
                  "properties": {
                    "route": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      ],
                      "description": "The route(s) that may answer this turn."
                    },
                    "answer": {
                      "type": "object",
                      "properties": {
                        "contains": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "notContains": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false,
                      "description": "Text the answer must or must not contain, after the language pack's folding."
                    },
                    "evidence": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "min": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "max": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "includes": {
                            "description": "Item ids that must be returned.",
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
                        "additionalProperties": false
                      },
                      "description": "Expectations per evidence collection, e.g. products: { min: 1 }."
                    },
                    "filters": {
                      "type": "object",
                      "properties": {
                        "maxPrice": {
                          "type": "number",
                          "minimum": 0
                        },
                        "minPrice": {
                          "type": "number",
                          "minimum": 0
                        },
                        "attributes": {
                          "description": "Evidence field name → required value.",
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
                          },
                          "additionalProperties": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false,
                      "description": "The filters the user asked for."
                    },
                    "productType": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      ],
                      "description": "The product type(s) the user asked for, as catalog types. A product of a type under one of them (by typeSeparator) matches."
                    },
                    "absentType": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The requested product type is absent from the catalog."
                    },
                    "answerable": {
                      "type": "boolean",
                      "description": "The request is answerable; a refusal is over-refusal."
                    },
                    "policyTopic": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
                      "description": "The turn asks about this policy."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "user"
              ],
              "additionalProperties": false
            }
          },
          "samples": {
            "description": "Defaults per suite (design §11).",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "checks": {
            "description": "Run only these checks. By default every applicable check runs.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "knownGap": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
            }
          },
          "provenance": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "const": "human"
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "default": "approved",
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "doc",
                      "prompt",
                      "contract",
                      "data",
                      "code",
                      "probe",
                      "import"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "proposed",
                      "approved",
                      "rejected"
                    ]
                  }
                },
                "required": [
                  "source",
                  "evidence",
                  "status"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "suite",
          "language",
          "turns"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false,
  "title": "yokla cases v1",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
