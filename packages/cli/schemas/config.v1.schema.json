{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "gate": {
      "default": {},
      "type": "object",
      "properties": {
        "maxFailures": {
          "description": "Cases with status fail a suite may have. Default 0.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allowUnmeasured": {
          "description": "Whether a suite may have unmeasured cases and thresholds. Default false: unmeasured is never a pass.",
          "type": "boolean"
        },
        "latencyP50Ms": {
          "description": "The median latency of the answered turns, every sample included (ADR-0014).",
          "type": "number",
          "minimum": 0
        },
        "latencyP95Ms": {
          "description": "The 95th percentile latency of the answered turns, every sample included.",
          "type": "number",
          "minimum": 0
        },
        "costPerTurnUsd": {
          "description": "The mean model cost of an answered turn, from the model proxy.",
          "type": "number",
          "minimum": 0
        },
        "costUsd": {
          "description": "The suite's total model cost, from the model proxy.",
          "type": "number",
          "minimum": 0
        },
        "suites": {
          "description": "Overrides per suite of the thresholds above.",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "quality",
              "factual",
              "redteam",
              "robustness",
              "perf",
              "resilience"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "maxFailures": {
                "description": "Cases with status fail a suite may have. Default 0.",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "allowUnmeasured": {
                "description": "Whether a suite may have unmeasured cases and thresholds. Default false: unmeasured is never a pass.",
                "type": "boolean"
              },
              "latencyP50Ms": {
                "description": "The median latency of the answered turns, every sample included (ADR-0014).",
                "type": "number",
                "minimum": 0
              },
              "latencyP95Ms": {
                "description": "The 95th percentile latency of the answered turns, every sample included.",
                "type": "number",
                "minimum": 0
              },
              "costPerTurnUsd": {
                "description": "The mean model cost of an answered turn, from the model proxy.",
                "type": "number",
                "minimum": 0
              },
              "costUsd": {
                "description": "The suite's total model cost, from the model proxy.",
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "maxRisk": {
          "description": "The highest risk score an attack kind of the approved cases may have, from 0 to 10: 10 × its severity's weight × its attack success rate (ADR-0089). Off by default.",
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "prices": {
      "default": {},
      "description": "Per upstream id, per model as the provider reports it (ADR-0012). A model without a price has no cost.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "input": {
              "type": "number",
              "minimum": 0
            },
            "output": {
              "type": "number",
              "minimum": 0
            },
            "cachedInput": {
              "description": "Defaults to the input price, so cost is never understated.",
              "type": "number",
              "minimum": 0
            },
            "cacheWrite": {
              "description": "Defaults to the input price, so cost is never understated.",
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "input",
            "output"
          ],
          "additionalProperties": false,
          "description": "USD per million tokens."
        }
      }
    },
    "judge": {
      "default": {},
      "description": "The calibrated judge (ADR-0090).",
      "type": "object",
      "properties": {
        "gate": {
          "description": "The judge dimensions that gate: one failing sample fails the case. Every other one is advisory (ADR-0005, ADR-0090).",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unsafe-advice",
              "hijacking",
              "unruled-restriction",
              "bias",
              "political-religious",
              "harmful-content",
              "imitation",
              "unverifiable-claim"
            ]
          }
        },
        "dimensions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "unsafe-advice",
              "hijacking",
              "unruled-restriction",
              "bias",
              "political-religious",
              "harmful-content",
              "imitation",
              "unverifiable-claim"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "notes": {
                "description": "Notes added to the dimension's rubric in the judge's prompt.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "examples": {
                "description": "Graded examples: calibration items the judge must grade right in every run, or its verdicts of the run are unmeasured.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "pattern": "^[a-z]{2}$"
                    },
                    "user": {
                      "type": "string",
                      "minLength": 1
                    },
                    "answer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "pass",
                        "fail"
                      ]
                    }
                  },
                  "required": [
                    "language",
                    "user",
                    "answer",
                    "verdict"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "models": {
      "default": {},
      "type": "object",
      "properties": {
        "customer": {
          "description": "The model that plays a simulated customer (ADR-0028). A hosted model receives the conversation, the target answers included.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "openai-compatible",
                "anthropic",
                "gemini"
              ]
            },
            "auth": {
              "default": "api-key",
              "description": "For gemini: the key in x-goog-api-key, or as an Authorization bearer token, as Vertex AI takes it (ADR-0032). The other kinds send it in their own header.",
              "type": "string",
              "enum": [
                "api-key",
                "bearer"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The base url, e.g. http://127.0.0.1:11434/v1 for a local model."
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "apiKeyEnv": {
              "description": "The environment variable that holds the API key, if one is needed.",
              "type": "string",
              "minLength": 1
            },
            "temperature": {
              "default": 0,
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "maxTokens": {
              "default": 400,
              "type": "integer",
              "minimum": 1,
              "maximum": 64000
            },
            "timeoutMs": {
              "default": 60000,
              "type": "integer",
              "minimum": 1,
              "maximum": 600000
            },
            "price": {
              "description": "USD per million tokens. Without it, the calls have no cost, never 0.",
              "type": "object",
              "properties": {
                "input": {
                  "type": "number",
                  "minimum": 0
                },
                "output": {
                  "type": "number",
                  "minimum": 0
                },
                "cachedInput": {
                  "description": "Defaults to the input price, so cost is never understated.",
                  "type": "number",
                  "minimum": 0
                },
                "cacheWrite": {
                  "description": "Defaults to the input price, so cost is never understated.",
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "url",
            "model"
          ],
          "additionalProperties": false
        },
