        "attacker": {
          "description": "The model yokla run --attacker uses to adapt the redteam cases' attacks (ADR-0087). A hosted model receives the attacks and the target's answers. It needs a price, 0 for a local model, so --max-cost can be enforced.",
          "type": "object",
          "properties": {
            "kind": {
