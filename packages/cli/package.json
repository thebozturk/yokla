{
  "name": "yokla",
  "version": "0.6.1",
  "description": "Test conversational AI assistants end to end.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebozturk/yokla.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/thebozturk/yokla#readme",
  "bugs": {
    "url": "https://github.com/thebozturk/yokla/issues"
  },
  "keywords": [
    "yokla",
    "llm",
    "ai-assistant",
    "chatbot",
    "testing",
    "evaluation",
    "end-to-end",
    "cli",
    "llm-testing",
    "llm-evaluation",
    "conversational-ai",
    "model-proxy",
    "e-commerce",
    "turkish"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__",
    "schemas"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yokla/analyzer": "workspace:*",
    "@yokla/core": "workspace:*",
    "@yokla/interop-rows": "workspace:*",
    "@yokla/pack-ecommerce": "workspace:*",
    "@yokla/pack-lang-en": "workspace:*",
    "@yokla/pack-lang-tr": "workspace:*",
    "@yokla/proxy": "workspace:*",
    "@yokla/report": "workspace:*",
    "@yokla/runtime": "workspace:*"
  },
  "bin": {
    "yokla": "./dist/bin.js"
  }
}
