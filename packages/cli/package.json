{
  "name": "yokla",
  "version": "0.1.0",
  "private": true,
  "description": "Test conversational AI assistants end to end.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "schemas"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yokla/core": "workspace:*",
    "@yokla/pack-ecommerce": "workspace:*",
    "@yokla/pack-lang-en": "workspace:*",
    "@yokla/pack-lang-tr": "workspace:*",
    "@yokla/proxy": "workspace:*",
    "@yokla/report": "workspace:*",
    "@yokla/runtime": "workspace:*"
  },
  "bin": {
    "yokla": "./dist/bin.js"
  }
}
