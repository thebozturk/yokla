{
  "name": "@yokla/core",
  "version": "0.5.0",
  "description": "Schemas, check API, aggregation and gate. Pure: no I/O, no network.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebozturk/yokla.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/thebozturk/yokla#readme",
  "bugs": {
    "url": "https://github.com/thebozturk/yokla/issues"
  },
  "keywords": [
    "yokla",
    "llm",
    "ai-assistant",
    "chatbot",
    "testing",
    "evaluation",
    "end-to-end",
    "schema"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@yokla/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__"
  ],
  "sideEffects": false,
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
