{
  "name": "@yokla/runtime",
  "version": "0.6.2",
  "description": "Runner, target adapters, model client, budget and file system access.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebozturk/yokla.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/thebozturk/yokla#readme",
  "bugs": {
    "url": "https://github.com/thebozturk/yokla/issues"
  },
  "keywords": [
    "yokla",
    "llm",
    "ai-assistant",
    "chatbot",
    "testing",
    "evaluation",
    "end-to-end",
    "runner",
    "websocket"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@yokla/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yokla/core": "workspace:*"
  }
}
