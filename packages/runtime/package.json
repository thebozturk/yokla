{
  "name": "@yokla/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Runner, target adapters, model client, budget and file system access.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@yokla/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yokla/core": "workspace:*"
  }
}
