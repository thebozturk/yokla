{
  "name": "@yokla/pack-lang-en",
  "version": "0.3.0",
  "private": true,
  "description": "English language pack for yokla.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebozturk/yokla.git",
    "directory": "packs/lang-en"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yokla/core": "workspace:*"
  }
}
