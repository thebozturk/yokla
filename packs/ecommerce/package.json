{
  "name": "@yokla/pack-ecommerce",
  "version": "0.4.3",
  "description": "E-commerce domain pack for yokla.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thebozturk/yokla.git",
    "directory": "packs/ecommerce"
  },
  "homepage": "https://github.com/thebozturk/yokla#readme",
  "bugs": {
    "url": "https://github.com/thebozturk/yokla/issues"
  },
  "keywords": [
    "yokla",
    "llm",
    "ai-assistant",
    "chatbot",
    "testing",
    "evaluation",
    "end-to-end",
    "e-commerce",
    "grounding"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "@yokla/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/__snapshots__",
    "!dist/checks/fixtures.*",
    "!src/checks/fixtures.ts"
  ],
  "sideEffects": false,
  "dependencies": {
    "@yokla/core": "workspace:*"
  }
}
